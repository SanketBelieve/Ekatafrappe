 "html": "{# \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n   Weekly Progress Report\n   Print Format for Timesheet\n   \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 #}\n\n<style>\n  .title-bar { background: #A3926E; padding: 8px; text-align: center; font-weight: bold; color: white; }\n  .hdr-table, .hdr-table td { border: none; padding: 4px; vertical-align: top; }\n  .legend-table { width:100%; margin:10px 0; }\n  .legend-table td { padding-right: 12px; }\n  .data-table, .data-table th, .data-table td {\n    border: 1px solid #000; border-collapse: collapse; padding: 6px;\n  }\n  .data-table th { text-align: center; font-weight: bold; }\n</style>\n\n<div class=\"title-bar\">WORK PROGRESS REPORT</div>\n\n<table class=\"hdr-table\" style=\"width:100%; margin-top:10px;\">\n  <tr>\n    <td><strong>Name:</strong></td>\n    <td>{{ doc.employee_name or doc.employee }}</td>\n    <td><strong>Reference No:</strong></td>\n    <td>{{ doc.name }}</td>\n  </tr>\n  <tr>\n    <td><strong>Document Type:</strong></td>\n    <td>Work Progress Report</td>\n    <td><strong>Date Of Submission:</strong></td>\n    <td>{{ doc.get_formatted(\"creation\") }}</td>\n  </tr>\n  <tr>\n    <td><strong>Designation:</strong></td>\n    <td>{{ doc.custom_designation or \"\" }}</td>\n    <td></td><td></td>\n  </tr>\n  <tr>\n    <td><strong>Department:</strong></td>\n    <td>{{ doc.department or \"\" }}</td>\n    <td></td><td></td>\n  </tr>\n</table>\n\n\n\n<table class=\"data-table\" style=\"width:100%;\">\n  <thead>\n    <tr>\n      <th>DATE</th>\n      <th>NO OF DAYS/HOUR</th>\n      <th>DESCRIPTION OF WORKS</th>\n      <th>STATUS</th>\n      <th>DELAY</th>\n      <th>IMPACT</th>\n      <th>REMARKS</th>\n    </tr>\n  </thead>\n  <tbody>\n    {% for row in doc.time_logs %}\n    <tr>\n      <td>{{ frappe.format_date(row.from_time) }}</td>\n      <td style=\"text-align:center;\">{{ row.hours or \"\" }}</td>\n      <td>{{ row.activity_type or \"\" }}</td>\n      <td style=\"text-align:center;\">{{ row.custom_status or \"\" }}</td>\n      <td style=\"text-align:center;\">{{ row.custom_delay or \"\" }}</td>\n      <td>{{ row.custom_impact or \"\" }}</td>\n      <td>{{ row.custom_remarks or \"\" }}</td>\n    </tr>\n    {% endfor %}\n  </tbody>\n</table>\n",
